# Copia este archivo a .env y ajusta lo que necesites.
# En docker-compose estos valores ya vienen seteados, así que .env es opcional.

# JWT
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio

# MySQL
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=ids
MYSQL_PASSWORD=ids_pass
MYSQL_DB=ids

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=ids_metrics

# Elasticsearch
ELASTIC_HOST=http://elasticsearch:9200
ELASTIC_USER=
ELASTIC_PASSWORD=
